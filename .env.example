# -----------------------------------------------------------------------------
# Copy to `.env` and fill in real values. NEVER commit the populated .env.
# -----------------------------------------------------------------------------

# HTTP
PORT=3000

# MySQL 8.x connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=gaming_app
DB_PASSWORD=change_me
DB_NAME=gaming
DB_CONNECTION_LIMIT=10

# Seconds a transaction will wait for a row lock before InnoDB aborts it.
# Kept short so a stuck bet fails fast (and is retried) instead of hanging.
DB_LOCK_WAIT_TIMEOUT=5

# Secret used to verify the JWT injected by the mobile app WebView.
# Use a long, random value in every environment. Rotate on suspected exposure.
JWT_SECRET=change_me_to_a_long_random_secret

# JWT claim that carries the internal numeric user_id (users.user_id).
JWT_USER_ID_CLAIM=sub

# Comma-separated allow-list of accepted JWT signing algorithms. Pin this to
# whatever the token issuer actually uses; never include "none".
JWT_ALGORITHMS=HS256

# --- Redis (leaderboard cache) -----------------------------------------------
# Set REDIS_ENABLED=false to run the leaderboard MySQL-only (still functional).
REDIS_ENABLED=true
REDIS_URL=redis://127.0.0.1:6379
# Fail a Redis command after this many ms and fall back to MySQL.
REDIS_COMMAND_TIMEOUT_MS=250
# TTLs (seconds) so per-day / per-week Redis keys expire and memory stays bounded.
LEADERBOARD_DAILY_TTL=172800
LEADERBOARD_WEEKLY_TTL=777600
# Secret for deriving opaque public player aliases on leaderboards.
# Defaults to JWT_SECRET if unset; set separately to rotate independently.
LEADERBOARD_ALIAS_SECRET=change_me_to_a_separate_long_random_secret

# Periodic reconciliation of leaderboard_scores from points_ledger (repairs drift).
# Cron expressions run in UTC; set an expression empty to disable that period's job.
LEADERBOARD_RECONCILE_ENABLED=true
LEADERBOARD_RECONCILE_DAILY_CRON=15 * * * *
LEADERBOARD_RECONCILE_WEEKLY_CRON=30 * * * *
LEADERBOARD_RECONCILE_GLOBAL_CRON=0 3 * * *
